{
  "name": "oncekey",
  "version": "0.2.0",
  "description": "Stripe-style Idempotency-Key for Node. Stores: Memory, SQLite, Postgres, Redis. Adapters: Fetch, Express, Hono, Fastify, Koa.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "import": "./dist/koa.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4",
    "hono": ">=4",
    "ioredis": ">=5",
    "koa": ">=2",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "fastify": { "optional": true },
    "hono": { "optional": true },
    "ioredis": { "optional": true },
    "koa": { "optional": true },
    "pg": { "optional": true }
  },
  "keywords": [
    "idempotency",
    "idempotency-key",
    "http",
    "retry",
    "payments",
    "express",
    "hono",
    "fastify",
    "koa",
    "postgres",
    "redis",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxGrushevsky/oncekey.git"
  },
  "bugs": {
    "url": "https://github.com/MaxGrushevsky/oncekey/issues"
  },
  "homepage": "https://github.com/MaxGrushevsky/oncekey#readme",
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "express": "^5.1.0",
    "fastify": "^5.12.5",
    "hono": "^4.7.5",
    "ioredis": "^6.0.0",
    "ioredis-mock": "^8.13.1",
    "koa": "^3.2.1",
    "pg": "^8.14.1",
    "supertest": "^7.3.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
